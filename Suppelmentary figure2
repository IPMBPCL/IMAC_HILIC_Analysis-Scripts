"""
Supplementary Figure 2: HILIC frit comparison — supplementary panels.

Self-contained. 2 panels, 1x2 layout.

Data: 1140881-1140896_frit_test_final_merged_results_with_composition_split.csv

Panels:
    A: N-glyco CV grouped bar (Total / CV<20% / CV<10%)
    B: Saccharide count violin
"""
import os
import re
from itertools import product
import warnings

import numpy as np
import pandas as pd
import matplotlib
import matplotlib.pyplot as plt
import matplotlib.image as mpimg
import matplotlib.patches as mpatches

matplotlib.rcParams['font.family'] = 'DejaVu Sans'
warnings.filterwarnings('ignore')


DATA_PATH = "/mnt/user-data/uploads/1140881-1140896_frit_test_final_merged_results_with_composition_split.csv"
OUTDIR = "/mnt/user-data/outputs"
os.makedirs(OUTDIR, exist_ok=True)

DPI_PANEL = 600; DPI_ASSEMBLED = 300
FIGSIZE = (3, 3)
FS_LABEL, FS_TICK, FS_LEGEND, FS_VALUE, FS_N = 10, 9, 6, 8, 6
COLORS = ['#AADCFA', '#78A5C8', '#8CB9B9', '#C8D2E6']
CONDITIONS = {
    'C8':   ['C8_1', 'C8_2', 'C8_3', 'C8_4'],
    'GF-A': ['GF_A_1', 'GF_A_2', 'GF_A_3', 'GF_A_4'],
    'GF-C': ['GF_C_1', 'GF_C_2', 'GF_C_3', 'GF_C_4'],
    'GF-F': ['GF_F_1', 'GF_F_2', 'GF_F_3', 'GF_F_4'],
}


def detected_mask(s):
    s = pd.to_numeric(s, errors='coerce')
    return s.notna() & (s > 0)


def style_ax(ax):
    for spine in ax.spines.values():
        spine.set_linewidth(1.5); spine.set_color('black')
    ax.tick_params(width=1.5, length=4, labelsize=FS_TICK)
    ax.yaxis.grid(True, linestyle='--', alpha=0.4, color='gray')
    ax.xaxis.grid(True, linestyle='--', alpha=0.4, color='gray')
    ax.set_axisbelow(True)


def cv_distribution(df, key_col, cond_cols, min_reps=3):
    sub = df[[key_col] + list(cond_cols)].copy()
    for c in cond_cols:
        sub[c] = pd.to_numeric(sub[c], errors='coerce')
    g = sub.groupby(key_col)[list(cond_cols)].max()
    valid = g.where(g > 0)
    keep = valid[valid.notna().sum(axis=1) >= min_reps]
    means = keep.mean(axis=1, skipna=True); stds = keep.std(axis=1, skipna=True)
    return (stds / means * 100).dropna().values


# Composition library for saccharide count
MASS = {'HexNAc': 203.0794, 'Hex': 162.0528, 'dHex': 146.0579,
        'Pent': 132.0423, 'NeuAc': 291.0954}
LIB = {}
for hn, hx, fc, px, na in product(range(9), range(13), range(4), range(4), range(5)):
    if hn == 0 and hx == 0:
        continue
    LIB[(hn, hx, fc, px, na)] = (
        hn*MASS['HexNAc'] + hx*MASS['Hex'] + fc*MASS['dHex']
        + px*MASS['Pent'] + na*MASS['NeuAc']
    )
LIB_ITEMS = list(LIB.items())


def parse_glycan_mass(mods):
    if pd.isna(mods): return None
    m = re.findall(r'N\(([\d.]+)\)', str(mods))
    return float(m[0]) if m else None


def match_composition(mass, tol=0.05):
    best, best_err = None, tol
    for comp, cm in LIB_ITEMS:
        e = abs(cm - mass)
        if e < best_err:
            best_err = e; best = comp
    return best


# ============================================================
# Load
# ============================================================
print("Loading data...")
df = pd.read_csv(DATA_PATH)
df['has_glyco'] = df['Assigned Modifications'].str.contains(r'N\(', na=False)
int_cols = [c for c in df.columns if 'Intensity' in c and 'MaxLFQ' not in c]

glyco = df[df['has_glyco'] & df['Composition'].notna()].copy()
glyco['glyco_key'] = glyco['Peptide Sequence'].astype(str) + '|' + glyco['Composition'].astype(str)
glyco_int = glyco.groupby('glyco_key')[int_cols].max().reset_index()
glyco_meta = glyco.drop_duplicates(subset='glyco_key').set_index('glyco_key')
for col in ['Assigned Modifications', 'Composition']:
    glyco_int[col] = glyco_int['glyco_key'].map(glyco_meta[col])
print(f"  Glyco: {len(glyco)} -> {len(glyco_int)} unique")


# ============================================================
# Panel A: CV grouped bar (Total / CV<20% / CV<10%)
# ============================================================
print("\nPanel A: CV grouped bar")
totals = []; n_cv20 = []; n_cv10 = []
for cname, reps in CONDITIONS.items():
    cond_cols = [next(c for c in int_cols if r in c) for r in reps]
    cvs = cv_distribution(glyco_int, 'glyco_key', cond_cols, min_reps=3)
    totals.append(len(cvs))
    n_cv20.append(int((cvs < 20).sum()))
    n_cv10.append(int((cvs < 10).sum()))

x = np.arange(len(CONDITIONS)); bw = 0.27
fig, ax = plt.subplots(figsize=FIGSIZE)
for i in range(len(CONDITIONS)):
    base = COLORS[i]
    ax.bar(i - bw, totals[i], bw, color=base, edgecolor='black', linewidth=1.0, alpha=0.4)
    ax.bar(i,      n_cv20[i], bw, color=base, edgecolor='black', linewidth=1.0, alpha=0.7)
    ax.bar(i + bw, n_cv10[i], bw, color=base, edgecolor='black', linewidth=1.0, alpha=1.0)
ax.legend(handles=[
    mpatches.Patch(facecolor='gray', alpha=0.4, edgecolor='black', label='Total'),
    mpatches.Patch(facecolor='gray', alpha=0.7, edgecolor='black', label='CV < 20%'),
    mpatches.Patch(facecolor='gray', alpha=1.0, edgecolor='black', label='CV < 10%'),
], loc='upper right', fontsize=FS_LEGEND, framealpha=0.95)
ax.set_xticks(x); ax.set_xticklabels(list(CONDITIONS.keys()), fontsize=FS_TICK)
ax.set_ylabel('Number of N-glycopeptides', fontsize=FS_LABEL)
style_ax(ax); plt.tight_layout()
panel_a = f"{OUTDIR}/suppfig2_panel_a_cv_grouped.png"
plt.savefig(panel_a, dpi=DPI_PANEL); plt.close()


# ============================================================
# Panel B: Saccharide count violin
# ============================================================
print("Panel B: Saccharide count")
glyco_int['_mass'] = glyco_int['Assigned Modifications'].apply(parse_glycan_mass)
glyco_int['_comp'] = glyco_int['_mass'].apply(lambda m: match_composition(m) if m else None)
glyco_int['_saccharides'] = glyco_int['_comp'].apply(lambda c: sum(c) if c else None)

sac_data = {c: [] for c in CONDITIONS}
for cname, reps in CONDITIONS.items():
    cond_cols = [next(c for c in int_cols if r in c) for r in reps]
    sub = glyco_int[glyco_int['_comp'].notna()].copy()
    n_det = pd.DataFrame({c: detected_mask(sub[c]).astype(int) for c in cond_cols}).sum(axis=1)
    keep = sub[n_det >= 3]
    sac_data[cname] = keep['_saccharides'].dropna().astype(int).tolist()

fig, ax = plt.subplots(figsize=FIGSIZE)
parts = ax.violinplot([sac_data[c] for c in CONDITIONS], positions=x,
                       showmedians=False, showextrema=False)
for pc, color in zip(parts['bodies'], COLORS):
    pc.set_facecolor(color); pc.set_alpha(0.85); pc.set_edgecolor('black'); pc.set_linewidth(1.0)
ax.boxplot([sac_data[c] for c in CONDITIONS], positions=x, widths=0.18,
           patch_artist=False, showfliers=False,
           medianprops=dict(color='red', linewidth=2),
           whiskerprops=dict(linewidth=1.0), capprops=dict(linewidth=1.0))
for i, c in enumerate(CONDITIONS):
    if sac_data[c]:
        med = int(np.median(sac_data[c])); n = len(sac_data[c])
        ax.text(i, med + 0.3, str(med), ha='center', va='bottom',
                fontsize=FS_VALUE, fontweight='bold')
        ax.text(i, 0.5, f'n={n}', ha='center', va='center',
                fontsize=FS_N, color='gray')
ax.set_xticks(x); ax.set_xticklabels(list(CONDITIONS.keys()), fontsize=FS_TICK)
ax.set_ylabel('Number of saccharides', fontsize=FS_LABEL)
ax.set_ylim(0, 14)
style_ax(ax); plt.tight_layout()
panel_b = f"{OUTDIR}/suppfig2_panel_b_saccharide.png"
plt.savefig(panel_b, dpi=DPI_PANEL); plt.close()


# ============================================================
# Assemble
# ============================================================
print("\nAssembling SuppFig 2...")
fig, axes = plt.subplots(1, 2, figsize=(8, 4))
for ax, (path, letter) in zip(axes, [(panel_a, 'A'), (panel_b, 'B')]):
    img = mpimg.imread(path)
    ax.imshow(img); ax.axis('off')
    ax.text(-0.08, 1.05, letter, transform=ax.transAxes,
            fontsize=18, fontweight='bold', ha='left', va='bottom')
plt.tight_layout(pad=0.5)
out_path = f"{OUTDIR}/SuppFig2_HILIC_supp.png"
plt.savefig(out_path, dpi=DPI_ASSEMBLED, bbox_inches='tight')
plt.close()
print(f"Saved {out_path}")
