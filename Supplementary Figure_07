"""
Supplementary Figure S7: stationary phase layer order, IMAC-HILIC vs HILIC-IMAC.
TRANSPARENT background, 600 DPI. 4 panels in 2x2 layout.

Addresses the question of why IMAC is packed above HILIC. Both configurations
were prepared at the same 10 mg HILIC loading, processed contemporaneously, and
searched in the same batch, so they are directly comparable.

    Standard  IMAC above HILIC   phospho '_10-10-PP-'    glyco '10_10_GP'
    Reversed  HILIC above IMAC   phospho 'REV-10-10-PP-' glyco 'REV10_10_GP'
              (samples 1150391-1150394 for the phosphopeptide fraction)

Panels:
    A: Phosphopeptide identifications, mono / multi stacked, single SD error bar
    B: Phosphopeptide selectivity, individual replicates shown
    C: Phosphopeptide coefficient of variation
    D: Phosphopeptides quantified, with the subsets below 20% and 10% CV
    E: N-glycopeptides quantified, with the subsets below 20% and 10% CV
    F: N-glycopeptide coefficient of variation

Coefficients of variation are computed for features detected in at least three
of four replicates, as elsewhere in the study. Bottom labels give the median.

Panels D and E count features quantified in at least three replicates, the same
sets used for the CV distributions in Panels C and F. Their totals therefore
differ from the per-replicate identification means shown in Panel A.

Data:
    1150375-1150394_HILIC_beads-PP_A227_20260410_Peptide_Precursor_Report.csv
    1150410-1150429_HILIC_beads_test_GP_A227_combined_modified_peptide.tsv

SAMPLE NAMING, PHASE 2 SERIES
    Phosphopeptide fraction    samples 1150375-1150394, searched in SpectroMine
    N-glycopeptide fraction    samples 1150410-1150429, searched in FragPipe

    10-10, 10-5, 10-2, 10-1    IMAC packed above HILIC (standard layer order)
                               at 10, 5, 2 and 1 mg HILIC loading
    REV-10-10 / REV10_10       HILIC packed above IMAC (reversed layer order)
                               at 10 mg HILIC loading; labelled HILIC-IMAC in
                               the layer order figure

    REV denotes this reversed configuration. It is NOT a reversed-sequence
    database decoy, although that is the usual meaning of the prefix in
    proteomics pipelines.

    This script compares the two layer orders directly. The internal
    condition names Standard and Reversed are plotted as IMAC-HILIC and
    HILIC-IMAC respectively.
"""
import os
import re
import warnings
from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib
import matplotlib.pyplot as plt
import matplotlib.image as mpimg
matplotlib.rcParams['font.family'] = 'DejaVu Sans'
warnings.filterwarnings('ignore')

# Paths are relative to the repository root. data/ holds the input reports
# and figures/ receives the output; the scripts themselves live in scripts/.
ROOT = Path(__file__).resolve().parents[1]
DATA_DIR = ROOT / "data"

PP_PATH = f"{DATA_DIR}/1150375-1150394_HILIC_beads-PP_A227_20260410_Peptide_Precursor_Report.csv"
GP_PATH = f"{DATA_DIR}/1150410-1150429_HILIC_beads_test_GP_A227_combined_modified_peptide.tsv"
OUTDIR = str(ROOT / "figures")
PANELDIR = str(ROOT / "figures" / "panels" / "figS7")
os.makedirs(OUTDIR, exist_ok=True); os.makedirs(PANELDIR, exist_ok=True)

DPI_PANEL = 600; DPI_ASSEMBLED = 600
FIGSIZE = (3, 3)
FS_LABEL, FS_TICK, FS_LEGEND, FS_VALUE = 10, 9, 6, 8
SAVE = dict(dpi=DPI_PANEL, transparent=True, bbox_inches='tight')

LABELS = ['IMAC-HILIC', 'HILIC-IMAC']
COLORS = ['#78A5C8', '#C8D2E6']
COLOR_MONO, COLOR_MULTI = '#87CEFA', '#4682B4'
CONDS = [('Standard', '_10-10-PP-', '10_10_GP'), ('Reversed', 'REV-10-10-PP-', 'REV10_10_GP')]

def detected_mask(s):
    s = pd.to_numeric(s, errors='coerce')
    return s.notna() & (s > 0)

def style_ax(ax):
    for sp in ax.spines.values():
        sp.set_linewidth(1.5); sp.set_color('black')
    ax.tick_params(width=1.5, length=4, labelsize=FS_TICK)
    ax.yaxis.grid(True, linestyle='--', alpha=0.4, color='gray')
    ax.xaxis.grid(True, linestyle='--', alpha=0.4, color='gray')
    ax.set_axisbelow(True); ax.set_facecolor('none')

def cv_dist(df, key, cols, min_reps=3):
    s = df[[key] + list(cols)].copy()
    for c in cols:
        s[c] = pd.to_numeric(s[c], errors='coerce')
    g = s.groupby(key)[list(cols)].max()
    v = g.where(g > 0)
    k = v[v.notna().sum(axis=1) >= min_reps]
    return ((k.std(axis=1, ddof=1) / k.mean(axis=1)) * 100).dropna().values

def cv_panel(data, colors, ylabel, ylim, yticks, path):
    fig, ax = plt.subplots(figsize=FIGSIZE)
    parts = ax.violinplot(data, positions=x, widths=0.35,
                          showmedians=False, showextrema=False)
    for pc, col in zip(parts['bodies'], colors):
        pc.set_facecolor(col); pc.set_alpha(0.85)
        pc.set_edgecolor('black'); pc.set_linewidth(1.0)
    ax.boxplot(data, positions=x, widths=0.10, patch_artist=False, showfliers=False,
               medianprops=dict(color='red', linewidth=2),
               whiskerprops=dict(linewidth=1.0), capprops=dict(linewidth=1.0))
    for i, d in enumerate(data):
        ax.text(i, ylim[0] + 2, f'{np.median(d):.1f}%', ha='center', va='center',
                fontsize=6, color='gray')
    ax.set_xticks(x); ax.set_xticklabels(LABELS, fontsize=FS_TICK)
    ax.set_ylabel(ylabel, fontsize=FS_LABEL)
    ax.set_ylim(*ylim); ax.set_yticks(yticks)
    style_ax(ax); plt.tight_layout()
    plt.savefig(path, **SAVE); plt.close()

print("Loading data...")
pp = pd.read_csv(PP_PATH, low_memory=False)
pp['is_phospho'] = pp['PP.PIMID'].str.contains(r'\[Phospho', na=False, regex=True)
pp['n_phospho'] = pp['PP.PIMID'].str.count(r'\[Phospho \(STY\)\]')
pp_phos = pp[pp['is_phospho']].copy()
qc = [c for c in pp.columns if 'Label-Free Quant' in c]

gp = pd.read_csv(GP_PATH, sep='\t', low_memory=False)
gp['has_glyco'] = gp['Assigned Modifications'].str.contains(r'N\(', na=False)
def gmass(s):
    if pd.isna(s): return 0.0
    m = re.findall(r'N\(([\d.]+)\)', str(s)); return float(m[0]) if m else 0.0
gg = gp[gp['has_glyco']].copy()
gg['key'] = gg['Peptide Sequence'].astype(str) + '|' + gg['Assigned Modifications'].apply(gmass).round(2).astype(str)
gi = [c for c in gp.columns if c.endswith(' Intensity') and 'MaxLFQ' not in c and 'Spectral' not in c]

x = np.arange(2); width = 0.38

# Panels D and E use one blue gradient rather than the condition colours,
# because the HILIC-IMAC colour is too pale to give three distinguishable shades.
C_TOT, C_20, C_10 = '#C9DDF0', '#6FA0CC', '#2F5D8C'

def cv_counts(cv):
    """Number of features with a valid CV, and those below 20% and 10%."""
    return len(cv), int((cv < 20).sum()), int((cv < 10).sum())

def nested_cv_panel(tot, n20, n10, ymax, yticks, ylabel, path):
    """Nested bars for the total, CV < 20% and CV < 10%.

    All three counts come from the same set of features quantified in at least
    three replicates, so CV < 10% lies within CV < 20%, which lies within the
    total. Opaque bars drawn back to front from zero give a stacked appearance
    whose band tops read directly as the three counts. A band too short to hold
    its label is left unlabelled.
    """
    fig, ax = plt.subplots(figsize=FIGSIZE)
    bt = ax.bar(x, tot, width, color=C_TOT, edgecolor='black', linewidth=1.0)
    b2 = ax.bar(x, n20, width, color=C_20,  edgecolor='black', linewidth=1.0)
    b1 = ax.bar(x, n10, width, color=C_10,  edgecolor='black', linewidth=1.0)
    th = 0.05 * ymax                    # approximate label height in data units
    for i in range(2):
        for top, bottom, col in [(tot[i], n20[i], 'black'),
                                 (n20[i], n10[i], 'black'),
                                 (n10[i], 0,      'white')]:
            if top - bottom >= 1.4 * th:
                ax.text(i, top - th, f'{top}', ha='center', va='center',
                        fontsize=FS_VALUE, fontweight='bold', color=col)
    ax.set_xticks(x); ax.set_xticklabels(LABELS, fontsize=FS_TICK)
    ax.set_ylabel(ylabel, fontsize=FS_LABEL)
    ax.set_ylim(0, ymax); ax.set_yticks(yticks); ax.set_xlim(-0.5, 1.5)
    ax.legend([bt, b2, b1], ['Total', 'CV < 20%', 'CV < 10%'],
              loc='upper right', fontsize=FS_LEGEND, framealpha=0.95, edgecolor='black')
    style_ax(ax); plt.tight_layout()
    plt.savefig(path, **SAVE); plt.close()

# ---------- Panel A: phosphopeptide identifications, mono / multi ----------
print("Panel A: phosphopeptide identifications")
mono_m, multi_m, tot_sd = [], [], []
for name, ppat, gpre in CONDS:
    mo, mu = [], []
    for c in [k for k in qc if ppat in k]:
        s = pp_phos[detected_mask(pp_phos[c])].drop_duplicates('PP.PIMID')
        mo.append((s['n_phospho'] == 1).sum()); mu.append((s['n_phospho'] > 1).sum())
    mono_m.append(np.mean(mo)); multi_m.append(np.mean(mu))
    tot_sd.append(np.std([a + b for a, b in zip(mo, mu)], ddof=1))
    print(f"  {name:<9} mono={np.mean(mo):.0f}  multi={np.mean(mu):.0f}  "
          f"total={np.mean(mo) + np.mean(mu):.0f} +/- {tot_sd[-1]:.0f}")
tot_m = [a + b for a, b in zip(mono_m, multi_m)]
fig, ax = plt.subplots(figsize=FIGSIZE)
bm = ax.bar(x, multi_m, width, color=COLOR_MULTI, edgecolor='black', linewidth=1.0)
bo = ax.bar(x, mono_m, width, bottom=multi_m, color=COLOR_MONO, edgecolor='black', linewidth=1.0)
# a single error bar: the SD of the per-replicate total
ax.errorbar(x, tot_m, yerr=tot_sd, fmt='none', ecolor='black',
            capsize=3, capthick=1.0, linewidth=1.0)
for i in range(2):
    ax.text(i, multi_m[i] / 2, f'{multi_m[i]:.0f}', ha='center', va='center',
            fontsize=FS_VALUE, fontweight='bold', color='white')
    ax.text(i, multi_m[i] + mono_m[i] / 2, f'{mono_m[i]:.0f}', ha='center', va='center',
            fontsize=FS_VALUE, fontweight='bold', color='black')
ax.set_xticks(x); ax.set_xticklabels(LABELS, fontsize=FS_TICK)
ax.set_ylabel('Number of phosphopeptides', fontsize=FS_LABEL)
ax.set_ylim(0, 4000); ax.set_xlim(-0.5, 1.5)
ax.legend([bo, bm], ['Mono-phosphorylated', 'Multiply phosphorylated'],
          loc='upper left', fontsize=FS_LEGEND, framealpha=0.95, edgecolor='black')
style_ax(ax); plt.tight_layout()
pa = f"{PANELDIR}/a.png"; plt.savefig(pa, **SAVE); plt.close()

# ---------- Panel B: selectivity, replicate level ----------
print("Panel B: phosphopeptide selectivity")
fig, ax = plt.subplots(figsize=FIGSIZE)
for i, (name, ppat, gpre) in enumerate(CONDS):
    sel = []
    for c in [k for k in qc if ppat in k]:
        det = detected_mask(pp[c])
        t = pp.loc[det, 'PP.PIMID'].nunique()
        p = pp.loc[det & pp['is_phospho'], 'PP.PIMID'].nunique()
        sel.append(p / t * 100 if t else 0)
    ax.hlines(np.mean(sel), i - 0.22, i + 0.22, color='red', linewidth=2, zorder=2)
    ax.scatter([i] * len(sel), sel, s=45, color=COLORS[i], edgecolor='black', linewidth=1, zorder=3)
    print(f"  {name:<9} {np.mean(sel):.1f} +/- {np.std(sel, ddof=1):.1f}%  reps={[f'{s:.1f}' for s in sel]}")
ax.set_xticks(x); ax.set_xticklabels(LABELS, fontsize=FS_TICK)
ax.set_ylabel('Phosphopeptide selectivity (%)', fontsize=FS_LABEL)
ax.set_ylim(0, 100); ax.set_xlim(-0.6, 1.6)
style_ax(ax); plt.tight_layout()
pb = f"{PANELDIR}/b.png"; plt.savefig(pb, **SAVE); plt.close()

# ---------- Panel C: phosphopeptide CV ----------
print("Panel C: phosphopeptide CV")
cvp = []
for name, ppat, gpre in CONDS:
    cv = cv_dist(pp_phos, 'PP.PIMID', [k for k in qc if ppat in k])
    cvp.append(cv)
    print(f"  {name:<9} median={np.median(cv):.1f}%  n={len(cv)}  "
          f"CV<20%={(cv < 20).sum() / len(cv) * 100:.0f}%")
cv_panel(cvp, COLORS, 'Phosphopeptide CV (%)', (-5, 80), [0, 20, 40, 60, 80],
         f"{PANELDIR}/c.png")
pc_cv = f"{PANELDIR}/c.png"

# ---------- Panel D: phosphopeptides, total and CV subsets ----------
print("Panel D: phosphopeptides, total and CV subsets")
ptot, p20, p10 = (list(v) for v in zip(*[cv_counts(cv) for cv in cvp]))
for (name, _, _), n, a, b in zip(CONDS, ptot, p20, p10):
    print(f"  {name:<9} quantified={n}  CV<20%={a} ({a / n * 100:.0f}%)  CV<10%={b} ({b / n * 100:.0f}%)")
pd_ = f"{PANELDIR}/d.png"
nested_cv_panel(ptot, p20, p10, 2500, [0, 500, 1000, 1500, 2000, 2500],
                'Number of phosphopeptides', pd_)

# ---------- Panel E: N-glycopeptides, total and CV subsets ----------
print("Panel E: N-glycopeptides, total and CV subsets")
cvg = [cv_dist(gg, 'key', [k for k in gi if k.startswith(gpre)]) for name, ppat, gpre in CONDS]
gtot, g20, g10 = (list(v) for v in zip(*[cv_counts(cv) for cv in cvg]))
for (name, _, _), n, a, b in zip(CONDS, gtot, g20, g10):
    print(f"  {name:<9} quantified={n}  CV<20%={a} ({a / n * 100:.0f}%)  CV<10%={b} ({b / n * 100:.0f}%)")
pe_ = f"{PANELDIR}/e.png"
nested_cv_panel(gtot, g20, g10, 1200, [0, 300, 600, 900, 1200],
                'Number of N-glycopeptides', pe_)

# ---------- Panel F: N-glycopeptide CV ----------
print("Panel F: N-glycopeptide CV")
for (name, _, _), cv in zip(CONDS, cvg):
    print(f"  {name:<9} median={np.median(cv):.1f}%  n={len(cv)}")
pf_ = f"{PANELDIR}/f.png"
cv_panel(cvg, COLORS, 'N-glycopeptide CV (%)', (-5, 80), [0, 20, 40, 60, 80], pf_)

# ---------- assemble ----------
print("\nAssembling Supplementary Figure S7...")
fig, axes = plt.subplots(2, 3, figsize=(12, 8))
fig.patch.set_alpha(0.0)
for ax, (p, L) in zip(axes.flatten(),
                      [(pa, 'A'), (pb, 'B'), (pc_cv, 'C'),
                       (pd_, 'D'), (pe_, 'E'), (pf_, 'F')]):
    ax.imshow(mpimg.imread(p)); ax.axis('off')
    ax.text(-0.08, 1.05, L, transform=ax.transAxes, fontsize=18, fontweight='bold',
            ha='left', va='bottom')
plt.tight_layout(pad=0.5)
out = f"{OUTDIR}/SuppFigS7_layer_order_transparent.png"
plt.savefig(out, dpi=DPI_ASSEMBLED, bbox_inches='tight', transparent=True)
plt.close()
print(f"Saved {out}")
