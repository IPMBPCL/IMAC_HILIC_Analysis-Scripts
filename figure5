gp_glyco['glycan_mass'] = gp_glyco['Assigned Modifications'].apply(parse_glycan_mass)
gp_glyco['composition'] = gp_glyco['glycan_mass'].apply(lambda m: match_composition(m) if m is not None else None)
gp_glyco['glycan_class'] = gp_glyco['composition'].apply(classify_4class)
gp_glyco['glyco_key'] = (gp_glyco['Peptide Sequence'].astype(str) + '|' + gp_glyco['glycan_mass'].round(2).astype(str))
gp_int_cols = [c for c in gp.columns if c.endswith(' Intensity') and 'MaxLFQ' not in c]

