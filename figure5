print("Panel G: Workflow comparison")
def pimid_per_rep(cols):
    out = {}
    for c in cols:
        rep = rep_label(c)
        det = detected_mask(pp_phos[c])
        out[rep] = out.get(rep, set()) | set(pp_phos.loc[det, 'PP.PIMID'].tolist())
    return out
def split(pset):
    sub = pp_phos[pp_phos['PP.PIMID'].isin(pset)].drop_duplicates('PP.PIMID')
    return (sub['n_phospho'] == 1).sum(), (sub['n_phospho'] > 1).sum()
c8_ap_d  = pimid_per_rep(cols_for(pp_quant_cols, 'C8-Sep-PP-Aq'))
c8_acn_d = pimid_per_rep(cols_for(pp_quant_cols, 'C8-Sep-PP-ACN'))
gfc_ap_d = pimid_per_rep(cols_for(pp_quant_cols, 'GFC-Sep-PP-Aq', drop_r1=True))
tim_d    = pimid_per_rep(cols_for(pp_quant_cols, 'TIM-PP'))
shared = sorted(set(c8_ap_d) & set(c8_acn_d))
c8_combined_d = {r: c8_ap_d[r] | c8_acn_d[r] for r in shared}
def per_rep_df(rep_dict):
    rows = []
    for r, p in rep_dict.items():
        m, mu = split(p); rows.append({'mono': m, 'multi': mu, 'total': m + mu})
    return pd.DataFrame(rows)
dfs_g = [per_rep_df(c8_combined_d), per_rep_df(gfc_ap_d), per_rep_df(tim_d)]
